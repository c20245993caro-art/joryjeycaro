
<header>
    <nav class="flex flex-wrap items-center justify-between gap-4 border-b-4 border-red-600 p-5">

        <a href="#home"
            class="white-accent border-2 border-red-600 px-5 py-3 font-black">
            JJC.
        </a>

        <div class="flex flex-wrap items-center gap-4 text-sm font-black">
            <a href="#about">ABOUT</a>
            <a href="#services">SERVICES</a>
            <a href="#contact">CONTACT</a>

            <button
                id="themeBtn"
                type="button"
                class="border-2 border-red-600 px-4 py-2">
                LIGHT MODE
            </button>

            <button
                id="replayBtn"
                type="button"
                class="border-2 border-red-600 px-4 py-2">
                REPLAY TIMELINE
            </button>
        </div>

    </nav>
</header>

<script>
    // DARK AND LIGHT MODE
    const themeBtn = document.querySelector("#themeBtn");

    function updateTheme() {
        const isDark = document.documentElement.classList.contains("dark");

        if (themeBtn) {
            themeBtn.textContent = isDark ? "LIGHT MODE" : "DARK MODE";
        }
    }

    // Load saved theme
    const savedTheme = localStorage.getItem("portfolio-theme");

    if (savedTheme === "light") {
        document.documentElement.classList.remove("dark");
    } else {
        document.documentElement.classList.add("dark");
    }

    updateTheme();

    // Switch theme
 
themeBtn?.addEventListener("click", () => {

    // ROTATE BUTTON 360 DEGREES
    gsap.to(themeBtn, {
        rotation: "+=360",
        duration: 0.6,
        ease: "power2.inOut"
    });

    // TOGGLE DARK AND LIGHT MODE
    document.documentElement.classList.toggle("dark");

    const isDark = document.documentElement.classList.contains("dark");

    localStorage.setItem(
        "portfolio-theme",
        isDark ? "dark" : "light"
    );

    updateTheme();

});


    // REPLAY TIMELINE
    document.querySelector("#replayBtn")?.addEventListener("click", () => {
        window.dispatchEvent(new Event("replay-timeline"));
    });
</script>
