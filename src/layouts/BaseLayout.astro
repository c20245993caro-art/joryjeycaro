
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const name = "Jory Jey Caro";
const position = "Manog kaon";
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{name} | {position}</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- GSAP -->
    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js">
    </script>

    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js">
    </script>
</head>

<body>

    <!-- Scroll Progress -->
    <div id="progressBar"></div>

    <!-- Cursor Glow -->
    <div id="cursorGlow"></div>

    <!-- Header -->
    <Header />

    <!-- Main Content -->
    <main>
        <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- GSAP Animation Script -->
    <script>
        import "../scripts/animation.js";
		
    </script>
<script>
            import { FallingLeaves } from "falling-leaves";

            new FallingLeaves({ shapes: ["maple", "oak", "ginkgo", "birch", "oval"] });
        </script>
</body>
</html>
